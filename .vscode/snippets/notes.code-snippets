{
  "Multiline highlight block": {
    "prefix": "noteblock",
    "body": [
      "!*",
      "${TM_SELECTED_TEXT:${1:Write your notes here}}",
      "*!"
    ],
    "description": "Wrap selected text in a multiline highlight block"
  },
  "Single-line highlight block": {
    "prefix": "noteinline",
    "body": [
      "!* $0 *!"
    ],
    "description": "Insert a single-line highlight block"
  }
}
